{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2021",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["src"],
  "references": []
}
