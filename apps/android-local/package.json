{
  "name": "@best/android-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug --init-script gradle-mirror.init.gradle",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease --init-script gradle-mirror.init.gradle"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@fontsource/vazirmatn": "^5.2.8",
    "@sqlite.org/sqlite-wasm": "^3.41.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  }
}
