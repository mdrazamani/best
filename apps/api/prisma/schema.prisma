datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkType {
  NEW_CONSTRUCTION
  REPAIR
}

enum OrderStage {
  RECEIVED
  IN_PROGRESS
  READY_IN_WAREHOUSE
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoicePayerType {
  CUSTOMER
  COLLABORATOR
}

enum InventoryLogType {
  INCREASE
  DECREASE
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  username     String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  locale       String     @default("fa")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  userRoles             UserRole[]
  sessions              Session[]
  createdCollaborators  Collaborator[] @relation("CollaboratorCreator")
  createdCustomers      Customer[]     @relation("CustomerCreator")
  createdMeshTypes      MeshType[]     @relation("MeshTypeCreator")
  createdOrders         Order[]        @relation("OrderCreator")
  createdInvoices       Invoice[]      @relation("InvoiceCreator")
  createdInvoicePayments InvoicePayment[] @relation("InvoicePaymentCreator")
  createdInventoryItems InventoryItem[] @relation("InventoryItemCreator")
  inventoryLogs         InventoryLog[]  @relation("InventoryLogActor")
  operationLogs         OperationLog[] @relation("OperationActor")

  @@index([firstName])
  @@index([lastName])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@index([isSystem])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  resource    String
  apiName     String
  method      String
  path        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, apiName])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  previousRefreshTokenHash String?
  previousRefreshValidUntil DateTime?
  deviceType       String?
  deviceModel      String?
  os               String?
  browser          String?
  timezone         String?
  country          String?
  language         String?
  ipAddress        String?
  userAgent        String?
  lastActivityAt   DateTime @default(now())
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@index([previousRefreshValidUntil])
}

model LoginAttempt {
  id          String   @id @default(uuid())
  username    String   @unique
  failedCount Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model Collaborator {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String?
  address     String?
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  createdBy User  @relation("CollaboratorCreator", fields: [createdById], references: [id])
  orders    Order[]
  referredCustomers Customer[] @relation("CustomerReferrer")

  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([deletedAt])
}

model Customer {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String?
  address     String?
  description String?
  createdById String
  referredByCollaboratorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  createdBy User  @relation("CustomerCreator", fields: [createdById], references: [id])
  referredByCollaborator Collaborator? @relation("CustomerReferrer", fields: [referredByCollaboratorId], references: [id])
  orders    Order[]

  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([referredByCollaboratorId])
  @@index([deletedAt])
}

model MeshType {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?
  isActive    Boolean  @default(true)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  isDefault   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  createdBy User  @relation("MeshTypeCreator", fields: [createdById], references: [id])
  lineItems OrderLineItem[]

  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
}

model Order {
  id              String     @id @default(uuid())
  orderNumber     String     @unique
  title           String?
  orderDateJalali String
  collaboratorId  String?
  customerId      String?
  createdById     String
  workType        WorkType
  width           Decimal?   @db.Decimal(18, 2)
  height          Decimal?   @db.Decimal(18, 2)
  quantity        Decimal?   @db.Decimal(18, 2)
  unitPrice       Decimal?   @db.Decimal(18, 2)
  totalPrice      Decimal    @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(18, 2)
  description     String?
  stage           OrderStage @default(RECEIVED)
  stageNote       String?
  expectedCompletionDate DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  createdBy    User          @relation("OrderCreator", fields: [createdById], references: [id])
  lineItems    OrderLineItem[]
  invoiceLinks InvoiceOrder[]
  operationLogs OperationLog[]

  @@index([orderDateJalali])
  @@index([collaboratorId])
  @@index([customerId])
  @@index([stage])
  @@index([workType])
  @@index([deletedAt])
}

model OrderLineItem {
  id        String   @id @default(uuid())
  orderId   String
  meshTypeId String
  width     Decimal  @db.Decimal(18, 2)
  height    Decimal  @db.Decimal(18, 2)
  quantity  Decimal  @db.Decimal(18, 2)
  unitPrice Decimal  @db.Decimal(18, 2)
  lineTotal Decimal  @db.Decimal(18, 2)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meshType  MeshType @relation(fields: [meshTypeId], references: [id])

  @@index([orderId])
  @@index([meshTypeId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber  String        @unique
  title          String?
  createdById    String
  amount         Decimal       @db.Decimal(18, 2)
  discountAmount Decimal       @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(18, 2)
  status         InvoiceStatus @default(UNPAID)
  payerType      InvoicePayerType @default(CUSTOMER)
  payerId        String?
  dueDate        DateTime?
  paidAt         DateTime?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  createdBy User  @relation("InvoiceCreator", fields: [createdById], references: [id])
  orders    InvoiceOrder[]
  payments  InvoicePayment[]

  @@index([status])
  @@index([dueDate])
  @@index([payerType, payerId])
  @@index([deletedAt])
}

model InvoiceOrder {
  id        String   @id @default(uuid())
  invoiceId String
  orderId   String
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@unique([invoiceId, orderId])
  @@index([invoiceId])
  @@index([orderId])
}

model InvoicePayment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Decimal  @db.Decimal(18, 2)
  paidAt      DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InvoicePaymentCreator", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@index([createdById])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  quantity    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  createdBy User           @relation("InventoryItemCreator", fields: [createdById], references: [id])
  logs      InventoryLog[]

  @@index([name])
  @@index([deletedAt])
}

model InventoryLog {
  id        String           @id @default(uuid())
  itemId    String
  actorId   String
  type      InventoryLogType
  amount    Int
  beforeQty Int
  afterQty  Int
  note      String?
  createdAt DateTime         @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User          @relation("InventoryLogActor", fields: [actorId], references: [id])

  @@index([itemId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model OperationLog {
  id          String   @id @default(uuid())
  actorId      String
  entityType   String
  entityId     String
  action       String
  description  String?
  payload      Json?
  orderId      String?
  createdAt    DateTime @default(now())

  actor User  @relation("OperationActor", fields: [actorId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([orderId])
  @@index([createdAt])
}

model BackupLog {
  id             String   @id @default(uuid())
  backupDir      String
  sqlFilePath    String
  excelDirectory String
  status         String
  message        String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
