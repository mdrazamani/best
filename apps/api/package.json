{
  "name": "@best/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "predev": "npm run build && node scripts/ensure-port-free.js",
    "dev": "nest start --watch",
    "clean": "rimraf dist dist-seed",
    "prebuild": "rimraf dist dist-seed",
    "build": "nest build",
    "prestart": "npm run build && node scripts/ensure-port-free.js",
    "start": "node dist/main.js",
    "prestart:prod": "npm run build && node scripts/ensure-port-free.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; require('./dist/main.js')\"",
    "lint": "eslint src",
    "offline:check": "node ../../scripts/offline/check-runtime-links.mjs",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "ts-node --project tsconfig.seed.json scripts/seed.ts",
    "seed:js": "node scripts/seed.js"
  },
  "prisma": {
    "seed": "./node_modules/.bin/ts-node --project tsconfig.seed.json scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^5.7.1",
    "archiver": "8.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "puppeteer": "^24.43.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/archiver": "7.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
