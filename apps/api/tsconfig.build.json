{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "stripInternal": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "paths": {
      "@app/*": ["*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "jest.config.ts",
    "**/*.spec.ts",
    "**/*.int.spec.ts"
  ],
  "include": ["src/**/*"]
}
